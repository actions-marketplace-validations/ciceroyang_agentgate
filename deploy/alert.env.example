# Alerting for scripts/healthcheck.sh.
#
# Install as /etc/agentgate/alert.env, owned by the agentgate user, mode 0600. The password is a
# secret and is never committed: this file exists so the shape is documented, not the value.
# Without it the check still runs and still exits non-zero; it just cannot send mail, and it says so.

SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=contact@xn--5kvo87g.com
SMTP_PASS=
# Sender defaults to SMTP_USER when omitted.
AGENTGATE_ALERT_FROM=contact@xn--5kvo87g.com
AGENTGATE_ALERT_TO=zhiliangtech@163.com
