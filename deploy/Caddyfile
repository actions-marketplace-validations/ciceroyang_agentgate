# agentgate 的站点。复制到 /etc/caddy/Caddyfile —— 但如果那个文件里已经有别的东西,
# **不要覆盖**,只把这个文件的内容追加进去(onboard-server.sh --with-caddy 就是这么做的)。
#
# 这里刻意不声明主域 xn--5kvo87g.com:那台机器的主域上已经跑着另一个站点(Next.js,由 Caddy
# 提供 HTTPS)。声明主域会把站点从另一个站点抢过来,而那不该由部署脚本单方面决定。
#
# 智量.com 是中文域名,证书与路由都用 punycode 写,Caddy 不接受中文字面量。

# 站 + API:同一个服务,静态页走文件,接口转发到本地 8080。
app.xn--5kvo87g.com {
	encode gzip

	# 浏览器侧的默认防线。这些不是"安全功能",是没有理由不带的几行。
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# HTML 是每天重建的(证据页尤其),让浏览器每次回源校验,而不是拿一份过期的副本。
	# 只对 HTML 生效:静态资源和 badge 不碰。
	@html {
		path *.html /
	}
	header @html Cache-Control "no-cache"

	handle /health {
		reverse_proxy 127.0.0.1:8080
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /badge/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		root * /var/www/zhiliang
		file_server
	}

	# 404 要是页面,不是一行纯文本。
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		root * /var/www/zhiliang
		file_server
	}
}

# 此模板未显式启用 HTTP 访问日志（没有 log 指令）；进程日志不等于访问日志。
# 若运营者另行启用访问日志，应说明 IP/UA 等字段、输出位置和保留期。
# 线上实际配置与保留期需单独核验，不能以此模板推定；见 docs/operations/legal/data-handling.md。

# 说明:
# - Caddy 会自动申请并续期 Let's Encrypt 证书,前提是 80/443 已放行且 DNS 已生效。
# - 香港机器不需要 ICP 备案;大陆机器必须先备案,否则 80/443 会被拦(见 plan-b-no-icp.md)。
# - 不要把 8080 暴露到公网:安全组只开 22 / 80 / 443,Caddy 通过回环访问服务。
